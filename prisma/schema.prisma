generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

model Chauffeur {
  id         Int        @id @default(autoincrement())
  nom        String
  depart     String?
  arrivee    String?
  capacite   Int        @default(4)
  special    Boolean    @default(false)
  phone      String?
  wabotKey   String?
  createdAt  DateTime   @default(now())
  passagers  Passager[]
}

model Contact {
  id        Int      @id @default(autoincrement())
  nom       String   @unique
  phone     String
  wabotKey  String
  createdAt DateTime @default(now())
}

model Passager {
  id          Int        @id @default(autoincrement())
  nom         String
  createdAt   DateTime   @default(now())
  chauffeurId Int?
  chauffeur   Chauffeur? @relation(fields: [chauffeurId], references: [id], onDelete: SetNull)
}
